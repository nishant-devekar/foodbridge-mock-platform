{
  "schema": "fb.journey/1",
  "id": "store-journey",
  "version": "1.4.0",
  "label": "Store journey",
  "meta": {
    "source": "context/control-tower/CONTROL_TOWER_JOURNEY.md (proposal, 15 Oct 2026)",
    "facts": "assets/ct/journey-facts.js",
    "note": "Types and payloads are read by the Control Tower (assets/ct/journey-view.js), never by the engine. say: {n} is the fact named by count. demo.facts are merged into the new-store demo's facts when its demo button is pressed. flow names a module the tower opens for the step (store-activation: its own modal); action is the step's button; cheer is what the assistant says over it."
  },
  "nodes": [
    { "id": "setup", "type": "chapter", "label": "Set up your store",
      "payload": { "line": "Let's get your store ready", "pins": ["products", "customers"], "event": "store.active",
                   "announce": { "on": "done", "title": "Your store is ready", "line": "Orders is open: take an order in two taps and send the invoice on WhatsApp.", "button": "Take your first order", "open": "order" } },
      "done": { "all": [ { "node": "products.fixed", "is": "done" }, { "node": "customers.fixed", "is": "done" } ] } },

    { "id": "products", "type": "area", "parent": "setup", "label": "Products",
      "payload": { "area": "products", "model": "products", "promise": "What you sell, with its unit, rate and GST: every order and invoice starts here" } },
    { "id": "products.added", "type": "stage", "parent": "products", "label": "Added",
      "payload": { "stage": "added", "ask": "Add your products", "how": "Drop your rate list or item master. Any XLSX or CSV works; I read it and lay it out like a sheet.", "cheer": "Let's fill your shelf first. Bring the file you already have.", "action": "Upload your product list", "flow": { "module": "store-activation", "step": "items", "mode": "setup" }, 
                   "screen": { "route": "#/product-master/finished-goods", "label": "Finished Goods" },
                   "demo": { "label": "Add the sample products", "facts": { "products": { "sample": true } } } },
      "done": { "fact": "products.count", "gte": 1 } },
    { "id": "products.fixed", "type": "stage", "parent": "products", "label": "Fixed", "requires": ["products.added"],
      "payload": { "stage": "fixed", "ask": "Fix the products hidden from customers", "count": "products.broken", "say": "{n} hidden from customers", "how": "No unit, no price or no category: each is one fix away from sale.", 
                   "reward": { "freeDays": 1 }, "screen": { "route": "#/product-master/finished-goods", "label": "Finished Goods" } },
      "done": { "all": [ { "fact": "products.count", "gte": 1 }, { "fact": "products.broken", "eq": 0 } ] } },
    { "id": "products.complete", "type": "stage", "parent": "products", "label": "Complete", "requires": ["products.fixed"], "optional": true,
      "payload": { "stage": "complete", "ask": "Clear what costs money or breaks an invoice", "count": "products.incomplete", "say": "{n} need work", "how": "Below cost, above MRP, a brand spelled two ways, no HSN code.",
                   "opens": "inventory", "reward": { "freeDays": 1 }, "screen": { "route": "#/product-master/finished-goods", "label": "Finished Goods" } },
      "done": { "all": [ { "fact": "products.count", "gte": 1 }, { "fact": "products.incomplete", "eq": 0 } ] } },

    { "id": "customers", "type": "area", "parent": "setup", "label": "Customers", "requires": ["products.added"],
      "payload": { "area": "customers", "locked": "after your first product", "source": "store-activation", "promise": "The shops you sell to, with a phone that works: orders, invoices and reminders go to them",
                   "tiles": [ { "k": "good", "word": "Ready", "fact": "customers.count" }, { "k": "bad", "word": "No address", "fact": "customers.incomplete" }, { "k": "ugly", "word": "To fix", "fact": "customers.broken" } ],
                   "announce": { "on": "available", "title": "Customers is open", "line": "Add the shops you sell to, straight from your phone contacts.", "button": "Add your customers", "open": "customers" } } },
    { "id": "customers.added", "type": "stage", "parent": "customers", "label": "Added",
      "payload": { "stage": "added", "ask": "Add your customers", "how": "Drop your customer list. Any XLSX or CSV works; names and phone numbers are enough.", "cheer": "Now the shops you sell to. A list with names and numbers is enough.", "action": "Upload your customer list", "flow": { "module": "store-activation", "step": "customers", "mode": "setup" }, 
                   "screen": { "route": "#/customer-management/b2b-customers", "label": "B2B Customers" },
                   "demo": { "label": "Add 18 sample customers", "facts": { "customers": { "count": 18, "broken": 2, "incomplete": 12 } } } },
      "done": { "fact": "customers.count", "gte": 1 } },
    { "id": "customers.fixed", "type": "stage", "parent": "customers", "label": "Fixed", "requires": ["customers.added"],
      "payload": { "stage": "fixed", "ask": "Fix the customers that can't be reached", "count": "customers.broken", "say": "{n} still need a fix", "how": "Every customer needs a name and a phone that works.", "cheer": "One more push. Fix these and your store is ready for orders.", "action": "Review your customers", "flow": { "module": "store-activation", "step": "customers", "mode": "setup" }, 
                   "reward": { "freeDays": 1 }, "screen": { "route": "#/customer-management/b2b-customers", "label": "B2B Customers" },
                   "demo": { "label": "Fix the 2 phone numbers", "facts": { "customers": { "broken": 0 } } } },
      "done": { "all": [ { "fact": "customers.count", "gte": 1 }, { "fact": "customers.broken", "eq": 0 } ] } },
    { "id": "customers.complete", "type": "stage", "parent": "customers", "label": "Complete", "requires": ["customers.fixed"], "optional": true,
      "payload": { "stage": "complete", "ask": "Pin where each customer is, for Deliveries", "count": "customers.incomplete", "say": "{n} have no delivery pin", "action": "Pin your customers",
                   "opens": "deliveries", "reward": { "freeDays": 1 }, "screen": { "route": "#/customer-management/b2b-customers", "label": "B2B Customers" },
                   "demo": { "label": "Pin the 12 customers", "facts": { "customers": { "incomplete": 0 } } } },
      "done": { "all": [ { "fact": "customers.count", "gte": 1 }, { "fact": "customers.incomplete", "eq": 0 } ] } },

    { "id": "first-orders", "type": "chapter", "label": "Take your first orders", "requires": ["setup"],
      "payload": { "line": "Your store is ready · take your first order", "pins": ["order", "customers"] } },
    { "id": "order", "type": "area", "parent": "first-orders", "label": "Orders", "payload": { "area": "order", "locked": "when your store is ready", "promise": "Take an order in two taps; the invoice goes to the customer on WhatsApp" } },
    { "id": "order.first", "type": "stage", "parent": "order", "label": "First order", "sticky": true,
      "payload": { "stage": "added", "ask": "Take your first order", "how": "Tap a customer, then tap + on what they want", "reward": { "freeDays": 2 },
                   "screen": { "route": "#/sales-orders", "label": "Sales Orders" },
                   "demo": { "label": "Take a sample order", "facts": { "orders": { "count": 1, "days": 1 } } } },
      "done": { "fact": "orders.count", "gte": 1 } },
    { "id": "order.sent", "type": "stage", "parent": "order", "label": "Invoice sent", "requires": ["order.first"],
      "payload": { "stage": "fixed", "ask": "Send the invoice to your customer on WhatsApp", "screen": { "route": "#/sales-orders", "label": "Sales Orders" },
                   "demo": { "label": "Send its invoice", "facts": { "orders": { "sent": 1 } } } },
      "done": { "fact": "orders.sent", "gte": 1 } },
    { "id": "order.rhythm", "type": "stage", "parent": "order", "label": "Orders on 3 days", "requires": ["order.first"],
      "payload": { "stage": "complete", "ask": "Take orders on 3 different days", "count": "orders.days", "say": "Orders on {n} of 3 days", "live": "order",
                   "screen": { "route": "#/sales-orders", "label": "Sales Orders" },
                   "demo": { "label": "Take orders on 3 days", "facts": { "orders": { "count": 4, "days": 3, "sent": 4 } } } },
      "done": { "fact": "orders.days", "gte": 3 } },

    { "id": "run-day", "type": "chapter", "label": "Run your day", "requires": ["order.first"],
      "payload": { "line": "First order in · deliver it and get paid", "pins": ["deliveries", "collections"],
                   "announce": { "on": "available", "title": "Your first order is in", "line": "Deliveries and Collections are open: deliver it and get paid.", "button": "Record the delivery", "open": "deliveries" } } },
    { "id": "deliveries", "type": "area", "parent": "run-day", "label": "Deliveries", "payload": { "area": "deliveries", "locked": "after your first order", "promise": "Every order to the door: delivered, missed or returned, with the money and empties" } },
    { "id": "deliveries.first", "type": "stage", "parent": "deliveries", "label": "First delivery", "sticky": true,
      "payload": { "stage": "added", "ask": "Record your first delivery", "reward": { "freeDays": 2 },
                   "screen": { "route": "#/distribution-logistics/delivery-management", "label": "Delivery Management" },
                   "demo": { "label": "Record a sample delivery", "facts": { "deliveries": { "count": 1 } } } },
      "done": { "fact": "deliveries.count", "gte": 1 } },
    { "id": "deliveries.van", "type": "stage", "parent": "deliveries", "label": "Van and driver", "requires": ["deliveries.first"],
      "payload": { "stage": "fixed", "ask": "Name your van and driver", "screen": { "route": "#/distribution-logistics/route-planning", "label": "Route Planning" },
                   "demo": { "label": "Add Van 1 and its driver", "facts": { "deliveries": { "vans": 1 } } } },
      "done": { "fact": "deliveries.vans", "gte": 1 } },
    { "id": "deliveries.day", "type": "stage", "parent": "deliveries", "label": "A day closed", "requires": ["deliveries.van"],
      "payload": { "stage": "complete", "ask": "Close a full day's route", "live": "deliveries",
                   "screen": { "route": "#/distribution-logistics/delivery-management", "label": "Delivery Management" },
                   "demo": { "label": "Close today's route", "facts": { "deliveries": { "daysClosed": 1, "count": 5 } } } },
      "done": { "fact": "deliveries.daysClosed", "gte": 1 } },
    { "id": "collections", "type": "area", "parent": "run-day", "label": "Collections", "payload": { "area": "collections", "locked": "after your first order", "promise": "Who owes you, how much and since when, and the nudge for each" } },
    { "id": "collections.first", "type": "stage", "parent": "collections", "label": "First payment", "sticky": true,
      "payload": { "stage": "added", "ask": "Record your first payment", "how": "Paid at the counter counts", "reward": { "freeDays": 2 },
                   "screen": { "route": "#/finance/customer-receivables", "label": "Customer Receivables" },
                   "demo": { "label": "Record a sample payment", "facts": { "payments": { "count": 1 }, "customers": { "noTerms": 3 } } } },
      "done": { "fact": "payments.count", "gte": 1 } },
    { "id": "collections.dues", "type": "stage", "parent": "collections", "label": "Opening dues", "requires": ["collections.first"], "optional": true,
      "payload": { "stage": "fixed", "ask": "Bring in what customers already owe you", "screen": { "route": "#/finance/customer-receivables", "label": "Customer Receivables" },
                   "demo": { "label": "Bring in the udhaar list", "facts": { "dues": { "imported": true } } } },
      "done": { "fact": "dues.imported", "truthy": true } },
    { "id": "collections.terms", "type": "stage", "parent": "collections", "label": "Credit days", "requires": ["collections.first"],
      "payload": { "stage": "complete", "ask": "Set credit days for customers who owe you", "count": "customers.noTerms", "say": "{n} owe you with no credit days", "live": "collections",
                   "screen": { "route": "#/customer-management/b2b-customers", "label": "B2B Customers" },
                   "demo": { "label": "Set their credit days", "facts": { "customers": { "noTerms": 0 } } } },
      "done": { "all": [ { "node": "collections.first", "is": "done" }, { "fact": "customers.noTerms", "eq": 0 } ] } },

    { "id": "stay-stocked", "type": "chapter", "label": "Stay stocked", "requires": ["order.first"], "priority": 1,
      "payload": { "line": "Your day is running · now keep stock right", "pins": ["deliveries", "collections"] } },
    { "id": "inventory", "type": "area", "parent": "stay-stocked", "label": "Inventory", "requires": ["products.fixed"],
      "payload": { "area": "inventory", "locked": "after your first order", "promise": "What is in stock, what runs out next and what is not moving",
                   "announce": { "on": "available", "title": "Inventory is open", "line": "Count your opening stock so FoodBridge knows what you can sell.", "button": "Count your stock", "open": "inventory" } } },
    { "id": "inventory.counted", "type": "stage", "parent": "inventory", "label": "Opening count",
      "payload": { "stage": "added", "ask": "Count your opening stock", "screen": { "route": "#/customer-management/stock-audit-health", "label": "Stock Audit" },
                   "demo": { "label": "Count 42 products", "facts": { "stock": { "counted": 42, "unknown": 5 } } } },
      "done": { "fact": "stock.counted", "gte": 1 } },
    { "id": "inventory.clean", "type": "stage", "parent": "inventory", "label": "No unknown stock", "requires": ["inventory.counted"],
      "payload": { "stage": "fixed", "ask": "Count the products with no stock figure", "count": "stock.unknown", "say": "{n} have no stock figure",
                   "screen": { "route": "#/customer-management/stock-audit-health", "label": "Stock Audit" },
                   "demo": { "label": "Count the 5 missing", "facts": { "stock": { "unknown": 0 } } } },
      "done": { "all": [ { "fact": "stock.counted", "gte": 1 }, { "fact": "stock.unknown", "eq": 0 } ] } },
    { "id": "inventory.moving", "type": "stage", "parent": "inventory", "label": "A week of moves", "requires": ["inventory.clean"],
      "payload": { "stage": "complete", "ask": "Keep stock moving with orders for 7 days", "count": "orders.days", "say": "Orders on {n} of 7 days", "live": "inventory",
                   "screen": { "route": "#/sales-orders", "label": "Sales Orders" },
                   "demo": { "label": "Run a week of orders", "facts": { "orders": { "days": 7, "count": 12, "sent": 12 } } } },
      "done": { "fact": "orders.days", "gte": 7 } },
    { "id": "purchase", "type": "area", "parent": "stay-stocked", "label": "Purchase", "requires": ["inventory.counted"],
      "skip": { "mark": "skip:purchase" },
      "payload": { "area": "purchase", "locked": "after your opening stock count", "promise": "What to buy, from whom, before you run out",
                   "announce": { "on": "available", "title": "Purchase is open", "line": "Add who you buy from, and FoodBridge says what to buy before you run out.", "button": "Add your suppliers", "open": "purchase" } } },
    { "id": "purchase.supplier", "type": "stage", "parent": "purchase", "label": "A supplier",
      "payload": { "stage": "added", "ask": "Add the suppliers you buy from", "screen": { "route": "#/procurement/supplier-management", "label": "Supplier Management" },
                   "demo": { "label": "Add 3 sample suppliers", "facts": { "suppliers": { "count": 3, "unmapped": 6 } } } },
      "done": { "fact": "suppliers.count", "gte": 1 } },
    { "id": "purchase.mapped", "type": "stage", "parent": "purchase", "label": "Suppliers on fast movers", "requires": ["purchase.supplier"],
      "payload": { "stage": "fixed", "ask": "Name who sells you each fast mover", "count": "suppliers.unmapped", "say": "{n} fast movers have no supplier",
                   "screen": { "route": "#/procurement/supplier-management", "label": "Supplier Management" },
                   "demo": { "label": "Name their suppliers", "facts": { "suppliers": { "unmapped": 0 } } } },
      "done": { "all": [ { "fact": "suppliers.count", "gte": 1 }, { "fact": "suppliers.unmapped", "eq": 0 } ] } },
    { "id": "purchase.received", "type": "stage", "parent": "purchase", "label": "First purchase in", "requires": ["purchase.mapped"],
      "payload": { "stage": "complete", "ask": "Receive your first purchase order", "live": "purchase",
                   "screen": { "route": "#/procurement/purchase-orders", "label": "Purchase Orders" },
                   "demo": { "label": "Receive a sample purchase", "facts": { "purchases": { "received": 1 } } } },
      "done": { "fact": "purchases.received", "gte": 1 } },
    { "id": "production", "type": "area", "parent": "stay-stocked", "label": "Production",
      "skip": { "not": { "fact": "business.makes", "truthy": true } }, "payload": { "area": "production", "locked": "after your first order", "promise": "Your production plan: what to make for the orders you have" } },
    { "id": "production.recipe", "type": "stage", "parent": "production", "label": "A recipe",
      "payload": { "stage": "added", "ask": "Write your first recipe", "screen": { "route": "#/production/configure-recipe", "label": "Recipes" },
                   "demo": { "label": "Add a sample recipe", "facts": { "production": { "recipes": 1 } } } },
      "done": { "fact": "production.recipes", "gte": 1 } },
    { "id": "production.batch", "type": "stage", "parent": "production", "label": "First batch", "requires": ["production.recipe"],
      "payload": { "stage": "complete", "ask": "Plan your first batch", "live": "production", "screen": { "route": "#/production/production-board", "label": "Production board" },
                   "demo": { "label": "Plan a sample batch", "facts": { "production": { "batches": 1 } } } },
      "done": { "fact": "production.batches", "gte": 1 } },

    { "id": "running", "type": "milestone", "label": "Running", "requires": ["run-day", "stay-stocked"],
      "payload": { "line": "Here is what needs your attention today", "pins": ["deliveries", "collections"], "mode": "running",
                   "announce": { "on": "available", "title": "Your store is running", "line": "Every area is live. From today the tower shows what needs you each day.", "button": "Open the tower" } } }
  ],
  "edges": [
    { "from": "deliveries.day", "to": "deliveries.first", "kind": "next" }
  ]
}
