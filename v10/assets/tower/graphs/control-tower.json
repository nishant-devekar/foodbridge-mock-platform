{
 "schema": "fb.journey/1",
 "id": "control-tower",
 "version": "2.0.0",
 "label": "Control Tower",
 "meta": {
  "note": "The whole Control Tower as one graph: the footer's tabs, every area (its words, icon, colours, rank, data source, how its cards group and read), each area's setup steps with their gates and coins, and the milestones. The engine (assets/journey/engine.js) walks it knowing none of this; the tower draws whatever it says. Facts: assets/ct/journey-facts.js plus store.new (a store set up from day one) and business.makes.",
  "contract": "assets/journey/fb.journey-1.schema.json",
  "from": "assets/journey/graphs/store-journey.json v1.5.0"
 },
 "settings": {
  "doneNeedsOpen": false
 },
 "start": "now",
 "nodes": [
  {
   "id": "tower",
   "type": "app",
   "label": "Control Tower",
   "done": "children",
   "payload": {
    "text": {
     "keepUpper": [
      "MRP",
      "GST",
      "HSN",
      "SBI",
      "ODC",
      "LLP",
      "FMCG",
      "M",
      "K",
      "S",
      "R"
     ],
     "units": {
      "GM": "gm",
      "KG": "kg",
      "ML": "ml",
      "LTR": "ltr",
      "G": "g",
      "L": "l",
      "PCS": "pcs"
     },
     "drop": [
      "\\(?\\s*OLD MRP\\s*\\d+\\s*\\)?,?",
      ",?\\s*NEW MRP\\s*\\d+"
     ],
     "codes": [
      "^[A-Z]{2}[-\\s]?\\d{1,2}[-\\s]?[A-Z]{0,3}[-\\s]?\\d{3,4}$",
      "^[A-Z]{1,4}-\\d{3,}(-\\d+)*$",
      "^#?\\d{5,}$"
     ]
    },
    "feed": {
     "oneCardPer": [
      "product"
     ],
     "minGroup": 2
    }
   }
  },
  {
   "id": "now",
   "type": "tab",
   "parent": "tower",
   "label": "Now",
   "done": true,
   "payload": {
    "view": "feed",
    "icon": "now",
    "home": true
   }
  },
  {
   "id": "business",
   "type": "tab",
