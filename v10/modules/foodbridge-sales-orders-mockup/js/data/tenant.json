  "orderWorkflow": {
    "itemStatuses": ["Accepted", "Cancel"],
    "deliveryAllowedStatuses": ["InProgress", "Ready for dispatch", "Dispatch Created", "Return Accepted"],
    "reOrderAllowedStatuses": [],
    "editAllowedStatuses": [],
    "invoiceAllowedStatuses": ["Delivered", "Ready for dispatch", "InProgress", "In Delivery"],
    "partialDeliveredStatus": "Partial Delivered",
    "completeDeliveredStatus": "Delivered",
    "sellerStockUpdateOnStatus": ["Delivered", "Return Accepted"],
    "buyerStockUpdateOnStatus": ["Delivered", "Return Accepted"],
    "stockReservationOnStatus": ["Pending"],
    "eligibleStatus": {
      "ORDER": { "forDispatch": ["Ready for dispatch"] },
      "DISPATCH": { "forDelivery": ["Dispatch Created"], "forReturn": ["Delivered"] },
      "DELIVERY": { "forTracking": ["Out for Delivery"] },
      "RETURN": { "forDispatch": ["Return Created"] },
      "RETURN_DISPATCH": { "forDelivery": ["Return Dispatch Created", "Return Accepted"] }
    },
    "statusWorkFlow": {
      "ORDER": [
        { "status": "Pending", "nextStatuses": ["Ready for dispatch"], "isAuditAllowed": true },
        { "status": "Ready for dispatch", "nextStatuses": [], "isAuditAllowed": true }
      ],
      "DISPATCH": [
        { "status": "Dispatch Created", "nextStatuses": ["Delivered"], "isAuditAllowed": true },
        { "status": "Delivered", "nextStatuses": [], "isAuditAllowed": true }
      ],
      "DELIVERY": [
        { "status": "Delivery Created", "nextStatuses": ["Vehicle Loading Completed"], "isAuditAllowed": true },
        { "status": "Vehicle Loading Completed", "nextStatuses": ["Out for Delivery"], "isAuditAllowed": true },
        { "status": "Out for Delivery", "nextStatuses": [] }
      ],
      "RETURN": [{ "status": "Return Created", "nextStatuses": [] }],
      "RETURN_DISPATCH": [{ "status": "Return Accepted", "nextStatuses": [] }],
      "PURCHASE_ORDER": [
        { "status": "InProgress", "nextStatuses": ["Delivered"], "isAuditAllowed": true },
        { "status": "Delivered", "nextStatuses": [] }
      ]
    }
  },
