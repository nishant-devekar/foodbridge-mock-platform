    { "name": "Sales Orders", "path": "orders", "submenus": [] },
    { "name": "Distribution & Logistics", "path": null, "submenus": [] },
    { "name": "Production", "path": null, "submenus": [] },
    { "name": "Inventory", "path": null, "submenus": [] },
    { "name": "Procurement", "path": null, "submenus": [] },
